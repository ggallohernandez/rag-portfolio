BASE_PATH=/
OPENAI_API_KEY=sk-your-openai-key

# Public bot protection (recommended when exposing without auth)
BOT_PROTECTION_ENABLED=true
BOT_TRUST_PROXY=true

# Per-IP fixed-window limits
BOT_RATE_LIMIT_WINDOW_MS=60000
BOT_PROJECT_CREATES_PER_WINDOW=15
BOT_CHAT_CREATES_PER_WINDOW=40
BOT_MESSAGES_PER_WINDOW=80
BOT_UPLOADS_PER_WINDOW=20
BOT_EVAL_RUNS_PER_WINDOW=10

# Maximum single upload size (bytes)
BOT_UPLOAD_MAX_BYTES=20971520
