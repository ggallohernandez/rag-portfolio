{
  "name": "rag-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:ui": "next dev",
    "start": "node dist/src/index.js",
    "start:worker": "node dist/src/worker.js",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "rm -rf public .next out && mkdir -p public && next build && cp -R out/. public/",
    "build": "npm run build:server && npm run build:ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:chaos": "vitest run test/chaos.nightly.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.8",
    "bullmq": "^5.10.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.575.0",
    "minio": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "next": "^16.1.6",
    "openai": "^4.83.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.8",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.10",
    "@types/react": "19.2.14",
    "@types/supertest": "^6.0.2",
    "autoprefixer": "^10.4.24",
    "fast-check": "^3.23.2",
    "postcss": "^8.5.6",
    "supertest": "^7.1.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
